# ── Core ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma (see src/config/prisma.js)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
PORT=5000
NODE_ENV=development

# JWT signing secret for citizen/officer/admin auth
JWT_SECRET="change-me-to-a-long-random-string"

# API key required by the ML ingestion endpoint (/api/v1/model/violations)
MODEL_API_KEY="change-me"

# ── Evidence storage (ImageKit) ────────────────────────────────────────────
IMAGEKIT_PUBLIC_KEY=""
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_URL_ENDPOINT=""

# ── SMS / OTP (Twilio) ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_VERIFY_SERVICE_SID=""
OTP_PROVIDER=console
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=30

# ── Demo payment module (docs/PAYMENTS.md) ─────────────────────────────────
# No gateway credentials are needed: no real money moves, ever.
# Set DEMO_PAYMENTS_ENABLED=false to disable payment creation and simulation entirely.
DEMO_PAYMENTS_ENABLED=true
# Outcome used when the client does not request one: SUCCESS | FAILED | PENDING
DEMO_PAYMENT_DEFAULT_OUTCOME=SUCCESS
# Allow the client to request a demo outcome. Defaults to true outside production,
# false when NODE_ENV=production.
DEMO_PAYMENT_ALLOW_CLIENT_OUTCOME=true
# Serialization-conflict retry budget (ms) for concurrent payment attempts.
PAYMENT_CONFLICT_RETRY_MS=10000
