generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  fullName  String
  email     String    @unique
  password  String
  role      UserRole  @default(CITIZEN)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vehicles  Vehicle[]
}

model Vehicle {
  id                 String      @id @default(uuid())
  registrationNumber String      @unique
  ownerId            String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  challans           Challan[]
  owner              User        @relation(fields: [ownerId], references: [id])
  violations         Violation[]

  @@index([ownerId])
}

model Violation {
  id                  String          @id @default(uuid())
  modelEventId        String          @unique
  vehicleId           String?
  violationType       ViolationType
  detectedPlate       String
  normalizedPlate     String
  ocrConfidence       Float
  frameNumber         Int?
  videoTimestampSec   Float?
  detectedAt          DateTime
  cameraId            String
  areaCode            String
  locationText        String?
  duplicateFlag       Boolean         @default(false)
  duplicateConfidence Float           @default(0)
  modelVersion        String
  rawModelPayload     Json
  status              ViolationStatus @default(RECEIVED)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  latitude            Float?
  longitude           Float?
  recommendation      Recommendation
  challan             Challan?
  evidence            Evidence?
  vehicle             Vehicle?        @relation(fields: [vehicleId], references: [id])

  @@index([vehicleId])
  @@index([status])
  @@index([cameraId])
  @@index([detectedAt])
}

model Evidence {
  id             String         @id @default(uuid())
  violationId    String         @unique
  createdAt      DateTime       @default(now())
  imageKitFileId String
  imageUrl       String
  updatedAt      DateTime       @updatedAt
  uploadedAt     DateTime       @default(now())
  uploadedBy     EvidenceSource
  violation      Violation      @relation(fields: [violationId], references: [id], onDelete: Cascade)
}

model Challan {
  id            String        @id @default(uuid())
  challanNumber String        @unique
  vehicleId     String
  violationId   String        @unique
  status        ChallanStatus @default(ISSUED)
  issuedAt      DateTime      @default(now())
  dueDate       DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  fineAmount    Decimal       @db.Decimal(10, 2)
  paidAt        DateTime?
  vehicle       Vehicle       @relation(fields: [vehicleId], references: [id])
  violation     Violation     @relation(fields: [violationId], references: [id])

  @@index([vehicleId])
  @@index([status])
}

enum UserRole {
  CITIZEN
  TRAFFIC_OFFICER
  GRIEVANCE_OFFICER
  ADMIN
}

enum ViolationType {
  NO_HELMET
  NO_SEATBELT
  RED_LIGHT_JUMP
  SPEEDING
  WRONG_SIDE
  ILLEGAL_PARKING
  LANE_VIOLATION
}

enum Recommendation {
  AUTO_VERIFY
  OFFICER_REVIEW
  REJECT
}

enum ViolationStatus {
  RECEIVED
  VERIFIED
  MANUAL_REVIEW
  REJECTED
  VEHICLE_NOT_FOUND
  DUPLICATE_REVIEW
  CHALLAN_GENERATED
}

enum ChallanStatus {
  ISSUED
  PENDING_PAYMENT
  PAID
  CANCELLED
  CLOSED
}

enum EvidenceSource {
  ML_MODEL
  TRAFFIC_OFFICER
}
