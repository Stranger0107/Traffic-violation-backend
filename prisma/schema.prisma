generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CITIZEN
  TRAFFIC_OFFICER
  GRIEVANCE_OFFICER
  ADMIN
}

enum ViolationType {
  NO_HELMET
  NO_SEATBELT
  RED_LIGHT_JUMP
  SPEEDING
  WRONG_SIDE
  ILLEGAL_PARKING
  LANE_VIOLATION
  MORE_THAN_2_PEOPLE_ON_BIKE
}

enum Recommendation {
  AUTO_VERIFY
  OFFICER_REVIEW
  REJECT
}

enum ViolationStatus {
  RECEIVED
  VERIFIED
  MANUAL_REVIEW
  REJECTED
  VEHICLE_NOT_FOUND
  DUPLICATE_REVIEW
  CHALLAN_GENERATED
}

enum ChallanStatus {
  ISSUED
  PENDING_PAYMENT
  PAID
  CANCELLED
  CLOSED
}

enum EvidenceSource {
  ML_MODEL
  TRAFFIC_OFFICER
}


model User {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  password  String
  role      UserRole @default(CITIZEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles Vehicle[]
}


model Vehicle {
  id                 String @id @default(uuid())

  registrationNumber String @unique

  ownerId String
  owner   User @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  violations Violation[]
  challans   Challan[]

  @@index([ownerId])
}


model Violation {
  id String @id @default(uuid())

  modelEventId String @unique

  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  violationType ViolationType

  detectedPlate   String
  normalizedPlate String

  ocrConfidence Float

  recommendation Recommendation

  frameNumber       Int?
  videoTimestampSec Float?

  detectedAt DateTime

  cameraId String

  areaCode     String
  locationText String?

  latitude  Float?
  longitude Float?

  duplicateFlag       Boolean @default(false)
  duplicateConfidence Float   @default(0)

  modelVersion String

  rawModelPayload Json

  status ViolationStatus @default(RECEIVED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence Evidence?
  challan  Challan?

  @@index([vehicleId])
  @@index([status])
  @@index([cameraId])
  @@index([detectedAt])
}


model Evidence {
  id String @id @default(uuid())

  violationId String    @unique
  violation   Violation @relation(fields: [violationId], references: [id], onDelete: Cascade)

  imageUrl String

  imageKitFileId String

  uploadedBy EvidenceSource

  uploadedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Challan {
  id String @id @default(uuid())

  challanNumber String @unique

  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id])

  violationId String    @unique
  violation   Violation @relation(fields: [violationId], references: [id])

  fineAmount Decimal @db.Decimal(10, 2)

  status ChallanStatus @default(ISSUED)

  issuedAt DateTime @default(now())

  dueDate DateTime

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId])
  @@index([status])
}